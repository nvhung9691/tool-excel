<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ToolExcel.Api</RootNamespace>
    <AssemblyName>ToolExcel.Api</AssemblyName>
  </PropertyGroup>

  <!-- Khong bien dich thu muc test vao project API (test la project rieng ToolExcel.Tests) -->
  <ItemGroup>
    <Compile Remove="ToolExcel.Tests\**" />
    <Content Remove="ToolExcel.Tests\**" />
    <None Remove="ToolExcel.Tests\**" />
  </ItemGroup>

  <!--
    Ma nguon frontend (React/Vite) khong thuoc project .NET. Phai loai tru, khong thi
    node_modules bi keo vao Content/None -> build cham va publish phinh to.
    Ket qua build cua Vite di ra wwwroot\ va duoc Web SDK phuc vu binh thuong.
  -->
  <ItemGroup>
    <Content Remove="frontend\**" />
    <None Remove="frontend\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oracle ADO.NET provider: goi PKG_DYNAMIC_EXPORT (ref cursor), ghi H_DATA/T_DATA -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.5.1" />
    <!-- Doc/ghi .xlsx (MIT license) -->
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- Xac thuc JWT Bearer -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.1.2" />
    <!-- Verify hash mat khau {bcrypt} (tuong thich Spring Security) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

</Project>
